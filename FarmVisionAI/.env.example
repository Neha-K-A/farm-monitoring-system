# Farm Vision AI - Environment Configuration Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and update with your actual values

# Flask Server Configuration
VISION_HOST=0.0.0.0
VISION_PORT=5000

# Camera Configuration
# IP Webcam URL (supports http://, https://)
# Examples:
#   - http://192.168.1.100:8080/video (IP camera with port)
#   - http://10.x.x.x:port/video (Example IP range)
#   - 0 (use default webcam/device 0)
CAMERA_SOURCE=http://10.251.206.46:8080/video

# AI Model Configuration
MODEL_NAME=yolov8m-seg

# Logging
LOG_LEVEL=INFO
